SECRET_KEY=change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=postgresql+psycopg://edgehub:edgehub@127.0.0.1:5432/edgehub
RUN_DB_MIGRATIONS_ON_STARTUP=false
SEED_DEFAULT_ALARM_RULES_ON_STARTUP=false
SEED_DEMO_DATA_ON_STARTUP=false
DATA_SOURCE_MODE=tdengine
TDENGINE_ENABLED=false
TDENGINE_URL=http://127.0.0.1:6041
TDENGINE_DATABASE=edgehub
TDENGINE_USERNAME=root
TDENGINE_PASSWORD=taosdata
TDENGINE_QUERY_TIMEOUT_SECONDS=8
MQTT_PUBLISH_ENABLED=false
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID_PREFIX=hmi-backend
MQTT_PARAMS_SET_TOPIC_TEMPLATE=edge/temperature/{device_id}/params/set
MQTT_PUBLISH_QOS=1
MQTT_PUBLISH_RETAIN=false
RECOMMENDATION_GENERATE_COOLDOWN_SEC=30
RECOMMENDATION_GENERATE_NEW_RECORD_AFTER_SEC=600
RECOMMENDATION_FLOAT_TOLERANCE=0.001

# AI Runtime (local orchestration)
AI_RUNTIME_CONFIG_PATH=../../runtime/ai_runtime_config.json
PROBLEM_CLASSIFIER_ENABLED=true
SUCCESS_PREDICTOR_ENABLED=true
PREVIEW_GAP_PREDICTOR_ENABLED=true
CANDIDATE_RANKER_ENABLED=true
PROBLEM_CLASSIFIER_MODEL_PATH=artifacts/problem_classifier/problem_classifier_tree.joblib
SUCCESS_MODEL_PATH=artifacts/recommendation_success/recommendation_success_tree.joblib
PREVIEW_GAP_MODEL_PATH=artifacts/preview_gap/preview_gap_baseline.joblib
SUCCESS_MODEL_VARIANT=tree
PREVIEW_GAP_MODEL_VARIANT=baseline
RANKER_ALPHA=0.65
RANKER_BETA=0.35
RANKER_CANDIDATE_COUNT=6
HIGH_GAP_PENALTY_THRESHOLD=0.75
USE_PROBLEM_CLASSIFIER_FOR_CANDIDATE_BIAS=false

# AI Runtime (remote service, optional)
AI_RUNTIME_REMOTE_ENABLED=false
AI_RUNTIME_REMOTE_BASE_URL=http://127.0.0.1:8010
AI_RUNTIME_REMOTE_TIMEOUT_SECONDS=5
AI_RUNTIME_REMOTE_API_KEY=

# Ops Console (optional external metrics endpoint integration)
OPS_ENABLE_EXTERNAL_METRICS=false
OPS_DATA_HUB_METRICS_URL=
OPS_RUNTIME_METRICS_URL=
OPS_METRICS_TIMEOUT_SECONDS=2
OPS_AI_HEALTH_ARTIFACT_MAX_AGE_DAYS=30
OPS_AI_HEALTH_UNTRUSTED_DANGER_RECALL_CRITICAL=0.30
OPS_AI_HEALTH_UNTRUSTED_FALLBACK_CRITICAL=0.60
OPS_AI_HEALTH_POOR_SUCCESS_MACRO_F1_MAX=0.55
OPS_AI_HEALTH_POOR_GAP_MACRO_F1_MAX=0.45
OPS_AI_HEALTH_POOR_DANGER_RECALL_MAX=0.45
OPS_AI_HEALTH_POOR_FALLBACK_MIN=0.40
OPS_AI_HEALTH_POOR_AI_MANUAL_DELTA_MIN=-0.05
OPS_AI_HEALTH_WATCH_SUCCESS_MACRO_F1_MAX=0.70
OPS_AI_HEALTH_WATCH_GAP_MACRO_F1_MAX=0.65
OPS_AI_HEALTH_WATCH_DANGER_RECALL_MAX=0.60
OPS_AI_HEALTH_WATCH_FALLBACK_MIN=0.25
OPS_AI_HEALTH_WATCH_AI_MANUAL_DELTA_MIN=0.00
# Example:
# OPS_ENABLE_EXTERNAL_METRICS=true
# OPS_DATA_HUB_METRICS_URL=http://127.0.0.1:8081/actuator/prometheus
# OPS_RUNTIME_METRICS_URL=http://127.0.0.1:8081/actuator/prometheus

HMI_LOG_LEVEL=INFO
HMI_CONSOLE_LOG_LEVEL=INFO
HMI_ACCESS_LOG_LEVEL=INFO
HMI_LOG_DIR=../../runtime/logs/hmi-backend
HMI_LOG_MAX_BYTES=10485760
HMI_LOG_BACKUP_COUNT=14
HMI_LOG_FILE_NAME=app.log
HMI_ERROR_LOG_FILE_NAME=error.log
HMI_ACCESS_LOG_FILE_NAME=access.log
